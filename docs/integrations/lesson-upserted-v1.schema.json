{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actgds.com/contracts/lesson-upserted-v1.schema.json",
  "title": "actgds-instructor-assistant/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "event_type",
    "occurred_at",
    "source",
    "learner",
    "instructor",
    "lesson",
    "progress"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "lesson.upserted"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "environment"
      ],
      "properties": {
        "system": {
          "const": "instructor-assistant"
        },
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        }
      }
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learner_id"
      ],
      "properties": {
        "learner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "instructor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructor_id",
        "display_name"
      ],
      "properties": {
        "instructor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_id",
        "lesson_number",
        "lesson_date",
        "start_time",
        "finish_time",
        "duration_minutes",
        "distance_km",
        "cumulative_minutes",
        "cumulative_km",
        "taught",
        "assessed",
        "achieved",
        "source_updated_at"
      ],
      "properties": {
        "lesson_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lesson_number": {
          "type": "integer",
          "minimum": 1
        },
        "lesson_date": {
          "type": "string",
          "format": "date"
        },
        "start_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "finish_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "cumulative_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "cumulative_km": {
          "type": "number",
          "minimum": 0
        },
        "taught": {
          "type": "array",
          "maxItems": 22,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([1-9]|1[0-9]|2[0-2])$"
          }
        },
        "assessed": {
          "type": "array",
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([1-9]|1[0-9]|2[0-2]|review_1_17|review_1_22|final_drive_23)$"
          }
        },
        "achieved": {
          "type": "array",
          "maxItems": 25,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([1-9]|1[0-9]|2[0-2]|review_1_17|review_1_22|final_drive_23)$"
          }
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "achieved_count",
        "total_competencies",
        "review_1_17",
        "review_1_22",
        "final_drive_23",
        "cbta_status"
      ],
      "properties": {
        "achieved_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 22
        },
        "total_competencies": {
          "const": 22
        },
        "review_1_17": {
          "type": "string",
          "enum": [
            "locked",
            "ready",
            "achieved"
          ]
        },
        "review_1_22": {
          "type": "string",
          "enum": [
            "locked",
            "ready",
            "achieved"
          ]
        },
        "final_drive_23": {
          "type": "string",
          "enum": [
            "locked",
            "ready",
            "achieved"
          ]
        },
        "cbta_status": {
          "type": "string",
          "enum": [
            "active",
            "completed"
          ]
        }
      }
    }
  }
}
